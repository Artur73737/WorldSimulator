LLM_API_KEY=put here api
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
DATABASE_URL=sqlite+aiosqlite:///./worldsim.db
REDIS_URL=redis://localhost:6379/0
SIMULATION_SEED=worldsim_default
MAX_AGENTS_DEFAULT=8

# Simulation Speed Settings
# Delay tra decadi in secondi (default: 3.0, raccomandato per vedere meglio: 5.0-10.0)
DECADE_DELAY_SECONDS=5.0
# Modalita slow per debugging (moltiplica il delay x2)
ENABLE_SLOW_MODE=false
